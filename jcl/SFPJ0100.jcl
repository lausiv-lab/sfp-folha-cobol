//SFPJ0100 JOB (SFP,FOLHA),'COMPILA SISTEMA SFP',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M
//*=================================================================*
//* JOB    : SFPJ0100                                               *
//* FUNCAO : COMPILACAO COMPLETA DO SISTEMA DE FOLHA                *
//*          MAPSETS BMS, MODULOS BATCH E MODULOS CICS              *
//* NOTA   : EXECUTAR APENAS APOS APROVACAO DA GMUD                 *
//*=================================================================*
//         JCLLIB ORDER=(SFP.PROD.PROCLIB)
//*
//*--- MAPSETS BMS -------------------------------------------------*
//BMS01    EXEC SFPPBMS,MAPSET=SFPM01
//BMS02    EXEC SFPPBMS,MAPSET=SFPM02
//*
//*--- MODULOS UTILITARIOS E DE CALCULO (SUBROTINAS) ---------------*
//UTIL     EXEC SFPPCOMP,MEMBRO=SFPUTIL
//LKED.SYSIN DD *
  MODE AMODE(31) RMODE(ANY)
  NAME SFPUTIL(R)
/*
//TRIB     EXEC SFPPCOMP,MEMBRO=SFP0310
//LKED.SYSIN DD *
  MODE AMODE(31) RMODE(ANY)
  NAME SFP0310(R)
/*
//*--- MODULOS BATCH -----------------------------------------------*
//CRITICA  EXEC SFPPCOMP,MEMBRO=SFP0200
//LKED.SYSIN DD *
  INCLUDE SYSLIB(SFPUTIL)
  NAME SFP0200(R)
/*
//CALCULO  EXEC SFPPCOMP,MEMBRO=SFP0300
//LKED.SYSIN DD *
  INCLUDE SYSLIB(SFP0310)
  INCLUDE SYSLIB(SFPUTIL)
  NAME SFP0300(R)
/*
//RESCISAO EXEC SFPPCOMP,MEMBRO=SFP0350
//LKED.SYSIN DD *
  INCLUDE SYSLIB(SFP0310)
  INCLUDE SYSLIB(SFPUTIL)
  NAME SFP0350(R)
/*
//CONTABIL EXEC SFPPCOMP,MEMBRO=SFP0400
//LKED.SYSIN DD *
  NAME SFP0400(R)
/*
//CONTRACH EXEC SFPPCOMP,MEMBRO=SFP0500
//LKED.SYSIN DD *
  INCLUDE SYSLIB(SFPUTIL)
  NAME SFP0500(R)
/*
//BANCARIO EXEC SFPPCOMP,MEMBRO=SFP0600
//LKED.SYSIN DD *
  NAME SFP0600(R)
/*
//*--- MODULOS CICS ------------------------------------------------*
//ONLEMP   EXEC SFPPCICS,MEMBRO=SFP0100
//ONLMOV   EXEC SFPPCICS,MEMBRO=SFP0120
//*
//*--- BIND DOS PLANOS DB2 -----------------------------------------*
//BIND     EXEC PGM=IKJEFT01,DYNAMNBR=20,COND=(4,LT)
//STEPLIB  DD DSN=DSN.V13.SDSNLOAD,DISP=SHR
//DBRMLIB  DD DSN=SFP.PROD.DBRMLIB,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  BIND PACKAGE(SFPPKG) MEMBER(SFP0100) -
       ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) -
       EXPLAIN(YES) OWNER(SFPADM) QUALIFIER(SFPADM)
  BIND PACKAGE(SFPPKG) MEMBER(SFP0120) -
       ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) -
       EXPLAIN(YES) OWNER(SFPADM) QUALIFIER(SFPADM)
  BIND PACKAGE(SFPPKG) MEMBER(SFP0400) -
       ACTION(REPLACE) ISOLATION(UR) VALIDATE(BIND) -
       EXPLAIN(YES) OWNER(SFPADM) QUALIFIER(SFPADM)
  BIND PLAN(SFPPLAN) PKLIST(SFPPKG.*) -
       ACTION(REPLACE) ISOLATION(CS) ACQUIRE(USE) RELEASE(COMMIT)
  END
/*
//
