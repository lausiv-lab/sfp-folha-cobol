--*****************************************************************
--* MEMBRO : SFPRORG - REORG E RUNSTATS DO BANCO DA FOLHA         *
--*****************************************************************
 REORG TABLESPACE DBSFP001.TSSFPFOL
       SHRLEVEL CHANGE
       MAPPINGTABLE SFPADM.MAP_TSSFPFOL
       SORTDATA SORTKEYS
       COPYDDN(SYSCOPY)
       STATISTICS TABLE(ALL) INDEX(ALL) UPDATE ALL

 REORG TABLESPACE DBSFP001.TSSFPMOV
       SHRLEVEL REFERENCE
       COPYDDN(SYSCOPY)
       STATISTICS TABLE(ALL) INDEX(ALL)

 RUNSTATS TABLESPACE DBSFP001.TSSFPCAD
          TABLE(ALL) INDEX(ALL)
          SHRLEVEL CHANGE
          REPORT NO UPDATE ALL
