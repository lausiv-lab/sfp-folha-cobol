--*****************************************************************
--* CARD DE CONTROLE DO UTILITARIO DSNUTILB - LOAD                *
--* MEMBRO : SFPLEMP - CARGA DO CADASTRO DE EMPREGADOS            *
--* ENTRADA: SFP.PROD.CADASTRO.EMPREGADO (LRECL 500 FB)           *
--*****************************************************************
 LOAD DATA INDDN(SFPEMP) LOG NO RESUME NO REPLACE
      ENFORCE CONSTRAINTS
      DISCARDDN(SYSDISC) DISCARDS 100
 INTO TABLE SFPADM.TB_EMPREGADO
 WHEN (1:1) <> 'X'
 (  MATRICULA         POSITION(001:008) DECIMAL EXTERNAL
  , NOME              POSITION(009:048) CHAR(40)
  , CPF               POSITION(049:059) DECIMAL EXTERNAL
  , PIS               POSITION(060:070) DECIMAL EXTERNAL
  , DT_ADMISSAO       POSITION(071:078) DATE EXTERNAL 'YYYYMMDD'
  , DT_DEMISSAO       POSITION(079:086) DATE EXTERNAL 'YYYYMMDD'
                      NULLIF (079:086) = '00000000'
  , DT_NASCIMENTO     POSITION(087:094) DATE EXTERNAL 'YYYYMMDD'
  , SITUACAO          POSITION(095:095) CHAR(01)
  , COD_CARGO         POSITION(096:099) INTEGER EXTERNAL
  , COD_DEPTO         POSITION(100:103) INTEGER EXTERNAL
  , CENTRO_CUSTO      POSITION(104:109) DECIMAL EXTERNAL
  , SALARIO_BASE      POSITION(110:120) DECIMAL EXTERNAL(11,2)
  , TIPO_SALARIO      POSITION(121:121) CHAR(01)
  , CARGA_HOR_MES     POSITION(122:124) INTEGER EXTERNAL
  , QTD_DEP_IRRF      POSITION(125:126) INTEGER EXTERNAL
  , QTD_DEP_SALFAM    POSITION(127:128) INTEGER EXTERNAL
  , PERC_INSALUBRID   POSITION(129:130) INTEGER EXTERNAL
  , IND_PERICULOSID   POSITION(131:131) CHAR(01)
  , IND_VALE_TRANSP   POSITION(132:132) CHAR(01)
  , VLR_VALE_TRANSP   POSITION(133:141) DECIMAL EXTERNAL(9,2)
  , IND_VALE_REFEIC   POSITION(142:142) CHAR(01)
  , VLR_VALE_REFEIC   POSITION(143:151) DECIMAL EXTERNAL(9,2)
  , IND_PLANO_SAUDE   POSITION(152:152) CHAR(01)
  , VLR_PLANO_SAUDE   POSITION(153:161) DECIMAL EXTERNAL(9,2)
  , PERC_PENSAO       POSITION(162:166) DECIMAL EXTERNAL(5,2)
  , VLR_PENSAO_FIXO   POSITION(167:175) DECIMAL EXTERNAL(9,2)
  , VLR_CONSIGNADO    POSITION(176:184) DECIMAL EXTERNAL(9,2)
  , QTD_PARC_CONSIG   POSITION(185:187) INTEGER EXTERNAL
  , IND_ADIANTAMENTO  POSITION(188:188) CHAR(01)
  , PERC_ADIANTAMENTO POSITION(189:191) INTEGER EXTERNAL
  , IND_SINDICALIZADO POSITION(192:192) CHAR(01)
  , BANCO             POSITION(193:195) INTEGER EXTERNAL
  , AGENCIA           POSITION(196:200) DECIMAL EXTERNAL
  , CONTA             POSITION(201:212) DECIMAL EXTERNAL
  , DIG_CONTA         POSITION(213:213) CHAR(01)
  , TIPO_CONTA        POSITION(214:214) CHAR(01)
  , CATEG_ESOCIAL     POSITION(215:217) INTEGER EXTERNAL
  , SEXO              POSITION(218:218) CHAR(01)
  , GRAU_INSTRUCAO    POSITION(219:220) INTEGER EXTERNAL
  , MEDIA_VARIAVEIS   POSITION(462:472) DECIMAL EXTERNAL(11,2)
  , SALDO_FGTS        POSITION(473:483) DECIMAL EXTERNAL(11,2)
 )
