--*****************************************************************
--* MEMBRO : SFPLFOL - CARGA DA FOLHA CALCULADA (DETALHE)         *
--* ENTRADA: SFP.PROD.FOLHA.CALCULADA (LRECL 120 FB)              *
--* NOTA   : USA LOAD PART PARA CARREGAR SOMENTE A PARTICAO DA    *
--*          COMPETENCIA CORRENTE, PRESERVANDO O HISTORICO        *
--*****************************************************************
 LOAD DATA INDDN(SFPFOL) LOG NO RESUME NO REPLACE
      STATISTICS TABLE(ALL) INDEX(ALL)
      SORTKEYS 5000000
      DISCARDDN(SYSDISC) DISCARDS 0
 INTO TABLE SFPADM.TB_FOLHA_CALC
 (  COMPETENCIA       POSITION(001:006) DECIMAL EXTERNAL
  , TIPO_FOLHA        POSITION(007:007) CHAR(01)
  , MATRICULA         POSITION(008:015) DECIMAL EXTERNAL
  , SEQUENCIA         POSITION(016:018) INTEGER EXTERNAL
  , COD_EVENTO        POSITION(019:022) INTEGER EXTERNAL
  , DESCRICAO         POSITION(023:052) CHAR(30)
  , NATUREZA          POSITION(053:053) CHAR(01)
  , REFERENCIA        POSITION(054:060) DECIMAL EXTERNAL(7,2)
  , VALOR             POSITION(061:071) DECIMAL EXTERNAL(11,2)
  , CENTRO_CUSTO      POSITION(072:077) DECIMAL EXTERNAL
  , CONTA_CONTABIL    POSITION(078:085) DECIMAL EXTERNAL
 )
