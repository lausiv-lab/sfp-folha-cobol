--*****************************************************************
--* MEMBRO : SFPLRES - CARGA DO RESUMO DA FOLHA POR EMPREGADO     *
--* ENTRADA: SFP.PROD.FOLHA.RESUMO (LRECL 250 FB)                 *
--*****************************************************************
 LOAD DATA INDDN(SFPRES) LOG NO RESUME NO REPLACE
      STATISTICS TABLE(ALL) INDEX(ALL)
 INTO TABLE SFPADM.TB_FOLHA_RESUMO
 (  COMPETENCIA       POSITION(001:006) DECIMAL EXTERNAL
  , TIPO_FOLHA        POSITION(007:007) CHAR(01)
  , MATRICULA         POSITION(008:015) DECIMAL EXTERNAL
  , NOME              POSITION(016:055) CHAR(40)
  , CENTRO_CUSTO      POSITION(056:061) DECIMAL EXTERNAL
  , SALARIO_BASE      POSITION(062:072) DECIMAL EXTERNAL(11,2)
  , TOT_PROVENTOS     POSITION(073:083) DECIMAL EXTERNAL(11,2)
  , TOT_DESCONTOS     POSITION(084:094) DECIMAL EXTERNAL(11,2)
  , LIQUIDO           POSITION(095:105) DECIMAL EXTERNAL(11,2)
  , BASE_INSS         POSITION(106:116) DECIMAL EXTERNAL(11,2)
  , BASE_IRRF         POSITION(117:127) DECIMAL EXTERNAL(11,2)
  , BASE_FGTS         POSITION(128:138) DECIMAL EXTERNAL(11,2)
  , VLR_INSS          POSITION(139:149) DECIMAL EXTERNAL(11,2)
  , VLR_IRRF          POSITION(150:160) DECIMAL EXTERNAL(11,2)
  , VLR_FGTS          POSITION(161:171) DECIMAL EXTERNAL(11,2)
  , VLR_SAL_FAMILIA   POSITION(172:180) DECIMAL EXTERNAL(9,2)
  , ALIQ_INSS_EFET    POSITION(181:185) DECIMAL EXTERNAL(5,2)
  , ALIQ_IRRF         POSITION(186:190) DECIMAL EXTERNAL(5,2)
  , QTD_EVENTOS       POSITION(191:193) INTEGER EXTERNAL
  , BANCO             POSITION(194:196) INTEGER EXTERNAL
  , AGENCIA           POSITION(197:201) DECIMAL EXTERNAL
  , CONTA             POSITION(202:213) DECIMAL EXTERNAL
  , DIG_CONTA         POSITION(214:214) CHAR(01)
  , CPF               POSITION(215:225) DECIMAL EXTERNAL
 )
