--*****************************************************************
--* CARD DE CONTROLE DO UTILITARIO DSNUTILB - LOAD                *
--* MEMBRO : SFPLEMC - CARGA DOS DADOS COMPLEMENTARES DO          *
--*          EMPREGADO (DADOS PESSOAIS, DOCUMENTOS E ENDERECO)    *
--* ENTRADA: SFP.PROD.CADASTRO.EMPREGADO (LRECL 500 FB)           *
--* OBSERVACAO: LE O MESMO ARQUIVO DO SFPLEMP, EM OUTRAS FAIXAS   *
--*****************************************************************
 LOAD DATA INDDN(SFPEMP) LOG NO RESUME NO REPLACE
      ENFORCE CONSTRAINTS
      DISCARDDN(SYSDISC) DISCARDS 100
 INTO TABLE SFPADM.TB_EMPREGADO_COMPL
 WHEN (1:1) <> 'X'
 (  MATRICULA         POSITION(001:008) DECIMAL EXTERNAL
  , ESTADO_CIVIL      POSITION(221:221) CHAR(01)
  , RACA_COR          POSITION(222:223) INTEGER EXTERNAL
  , NACIONALIDADE     POSITION(224:226) INTEGER EXTERNAL
  , UF_NASCIMENTO     POSITION(227:228) CHAR(02)
  , MUN_NASCIMENTO    POSITION(229:235) DECIMAL EXTERNAL
  , NOME_MAE          POSITION(236:275) CHAR(40)
  , IND_DEFICIENCIA   POSITION(276:276) CHAR(01)
  , TIPO_DEFICIENCIA  POSITION(277:278) INTEGER EXTERNAL
  , CTPS_NUMERO       POSITION(279:286) DECIMAL EXTERNAL
  , CTPS_SERIE        POSITION(287:291) DECIMAL EXTERNAL
  , CTPS_UF           POSITION(292:293) CHAR(02)
  , RG_NUMERO         POSITION(294:308) CHAR(15)
  , RG_ORGAO          POSITION(309:316) CHAR(08)
  , TITULO_ELEITOR    POSITION(317:328) DECIMAL EXTERNAL
  , TIPO_LOGRADOURO   POSITION(329:331) CHAR(03)
  , LOGRADOURO        POSITION(332:371) CHAR(40)
  , NUMERO            POSITION(372:379) CHAR(08)
  , COMPLEMENTO       POSITION(380:394) CHAR(15)
  , BAIRRO            POSITION(395:419) CHAR(25)
  , COD_MUNICIPIO     POSITION(420:426) DECIMAL EXTERNAL
  , UF                POSITION(427:428) CHAR(02)
  , CEP               POSITION(429:436) DECIMAL EXTERNAL
  , TELEFONE          POSITION(437:450) CHAR(14)
  , COD_ESTABELEC     POSITION(451:454) INTEGER EXTERNAL
  , TIPO_VINCULO      POSITION(455:456) INTEGER EXTERNAL
  , TIPO_JORNADA      POSITION(457:458) INTEGER EXTERNAL
  , COD_HORARIO       POSITION(459:461) INTEGER EXTERNAL
  , TS_ATUALIZACAO    CURRENT TIMESTAMP
  , USUARIO_ATUALIZ   CONSTANT 'SFPLOAD '
 )
