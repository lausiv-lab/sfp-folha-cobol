***********************************************************************
* MAPSET  : SFPM03  - CADASTRO DE RUBRICAS E EVENTOS                  *
* MAPA    : MAPEVEN                                                   *
***********************************************************************
SFPM03   DFHMSD TYPE=&SYSPARM,                                        X
               MODE=INOUT,                                            X
               LANG=COBOL,                                            X
               STORAGE=AUTO,                                          X
               TIOAPFX=YES,                                           X
               CTRL=(FREEKB,FRSET),                                   X
               MAPATTS=(COLOR,HILIGHT),                               X
               DSATTS=(COLOR,HILIGHT),                                X
               EXTATT=YES
***********************************************************************
MAPEVEN  DFHMDI SIZE=(24,80),                                         X
               LINE=1,                                                X
               COLUMN=1
***********************************************************************
         DFHMDF POS=(1,1),LENGTH=7,ATTRB=(PROT,NORM),                 X
               COLOR=BLUE,INITIAL='SFP0110'
