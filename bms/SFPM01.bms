***********************************************************************
* MAPSET  : SFPM01 - MANUTENCAO DO CADASTRO DE EMPREGADOS             *
* MAPA    : MAPEMP - TELA 24 X 80                                     *
* PROGRAMA: SFP0100                                                   *
* TRANSACAO: SF01                                                     *
***********************************************************************
SFPM01   DFHMSD TYPE=&SYSPARM,                                         X
               MODE=INOUT,                                             X
               LANG=COBOL,                                             X
               STORAGE=AUTO,                                           X
               TIOAPFX=YES,                                            X
               CTRL=(FREEKB,FRSET),                                    X
               MAPATTS=(COLOR,HILIGHT),                                X
               DSATTS=(COLOR,HILIGHT),                                 X
               EXTATT=YES
***********************************************************************
MAPEMP   DFHMDI SIZE=(24,80),                                          X
               LINE=1,                                                 X
               COLUMN=1
***********************************************************************
* LINHA 1 - IDENTIFICACAO DO SISTEMA                                  *
***********************************************************************
         DFHMDF POS=(01,01),LENGTH=07,ATTRB=(PROT,NORM),               X
               COLOR=BLUE,INITIAL='SFP0100'
         DFHMDF POS=(01,20),LENGTH=41,ATTRB=(PROT,BRT),                X
               COLOR=NEUTRAL,                                          X
               INITIAL='SISTEMA DE FOLHA DE PAGAMENTO - CADASTRO'
