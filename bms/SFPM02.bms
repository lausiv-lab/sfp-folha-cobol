               COLOR=TURQUOISE,HILIGHT=UNDERLINE
         DFHMDF POS=(04,74),LENGTH=01,ATTRB=(ASKIP,NORM)
MSALARI  DFHMDF POS=(05,01),LENGTH=45,ATTRB=(PROT,NORM),               X
               COLOR=YELLOW
