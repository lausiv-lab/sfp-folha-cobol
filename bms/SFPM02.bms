***********************************************************************
* MAPSET  : SFPM02 - LANCAMENTO DO MOVIMENTO MENSAL                   *
* MAPA    : MAPMOV - TELA 24 X 80 COM 10 LINHAS DE DETALHE            *
* PROGRAMA: SFP0120                                                   *
* TRANSACAO: SF03                                                     *
***********************************************************************
SFPM02   DFHMSD TYPE=&SYSPARM,                                         X
               MODE=INOUT,                                             X
               LANG=COBOL,                                             X
               STORAGE=AUTO,                                           X
               TIOAPFX=YES,                                            X
               CTRL=(FREEKB,FRSET),                                    X
               MAPATTS=(COLOR,HILIGHT),                                X
               DSATTS=(COLOR,HILIGHT),                                 X
               EXTATT=YES
***********************************************************************
MAPMOV   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
***********************************************************************
         DFHMDF POS=(01,01),LENGTH=07,ATTRB=(PROT,NORM),               X
               COLOR=BLUE,INITIAL='SFP0120'
         DFHMDF POS=(01,18),LENGTH=44,ATTRB=(PROT,BRT),                X
               COLOR=NEUTRAL,                                          X
               INITIAL='LANCAMENTO DE MOVIMENTO MENSAL DA FOLHA'
MDATA    DFHMDF POS=(01,70),LENGTH=10,ATTRB=(PROT,NORM),COLOR=BLUE
         DFHMDF POS=(02,01),LENGTH=79,ATTRB=(PROT,NORM),COLOR=BLUE,    X
               INITIAL='===============================================X
               ================================'
***********************************************************************
* CABECALHO: MATRICULA E COMPETENCIA                                  *
***********************************************************************
         DFHMDF POS=(04,01),LENGTH=10,ATTRB=(PROT,NORM),               X
               COLOR=GREEN,INITIAL='MATRICULA:'
MMATRIC  DFHMDF POS=(04,12),LENGTH=08,ATTRB=(UNPROT,NUM,IC),           X
               COLOR=TURQUOISE,HILIGHT=UNDERLINE
         DFHMDF POS=(04,21),LENGTH=01,ATTRB=(ASKIP,NORM)
MNOME    DFHMDF POS=(04,23),LENGTH=35,ATTRB=(PROT,BRT),                X
               COLOR=NEUTRAL
         DFHMDF POS=(04,59),LENGTH=07,ATTRB=(PROT,NORM),               X
               COLOR=GREEN,INITIAL='COMPET:'
