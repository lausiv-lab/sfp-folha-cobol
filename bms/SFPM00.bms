***********************************************************************
* MAPSET  : SFPM00  - MENU PRINCIPAL DO SISTEMA SFP                   *
* MAPA    : MAPMENU                                                   *
* PROGRAMA: SFP0000    TRANSACAO: SFPM                                *
***********************************************************************
SFPM00   DFHMSD TYPE=&SYSPARM,                                         X
               MODE=INOUT,                                             X
               LANG=COBOL,                                             X
               STORAGE=AUTO,                                           X
               TIOAPFX=YES,                                            X
               CTRL=(FREEKB,FRSET),                                    X
               MAPATTS=(COLOR,HILIGHT),                                X
               DSATTS=(COLOR,HILIGHT),                                 X
               EXTATT=YES
***********************************************************************
MAPMENU  DFHMDI SIZE=(24,80),                                          X
               LINE=1,                                                 X
               COLUMN=1
***********************************************************************
* LINHA 1 - IDENTIFICACAO                                             *
***********************************************************************
         DFHMDF POS=(1,1),LENGTH=7,ATTRB=(PROT,NORM),                  X
               COLOR=BLUE,INITIAL='SFP0000'
         DFHMDF POS=(1,22),LENGTH=36,ATTRB=(PROT,BRT),                 X
               COLOR=NEUTRAL,                                          X
               INITIAL='SISTEMA DE FOLHA DE PAGAMENTO - SFP'
         DFHMDF POS=(1,70),LENGTH=10,ATTRB=(PROT,NORM),                X
               COLOR=BLUE,INITIAL='MENU GERAL'
***********************************************************************
* LINHA 2 - DATA E HORA                                               *
***********************************************************************
         DFHMDF POS=(2,1),LENGTH=5,ATTRB=(PROT,NORM),                  X
               COLOR=BLUE,INITIAL='DATA:'
MDATA    DFHMDF POS=(2,7),LENGTH=10,ATTRB=(PROT,NORM),                 X
               COLOR=TURQUOISE
         DFHMDF POS=(2,20),LENGTH=5,ATTRB=(PROT,NORM),                 X
               COLOR=BLUE,INITIAL='HORA:'
MHORA    DFHMDF POS=(2,26),LENGTH=8,ATTRB=(PROT,NORM),                 X
               COLOR=TURQUOISE
         DFHMDF POS=(2,50),LENGTH=8,ATTRB=(PROT,NORM),                 X
               COLOR=BLUE,INITIAL='USUARIO:'
MUSER    DFHMDF POS=(2,59),LENGTH=8,ATTRB=(PROT,NORM),                 X
               COLOR=TURQUOISE
         DFHMDF POS=(3,1),LENGTH=79,ATTRB=(PROT,NORM),                 X
               COLOR=BLUE,                                             X
               INITIAL='---------------------------------------------- X
---------------------------------'
***********************************************************************
* BLOCO 1 - CADASTROS BASICOS                                         *
***********************************************************************
         DFHMDF POS=(4,3),LENGTH=28,ATTRB=(PROT,BRT),                  X
               COLOR=YELLOW,INITIAL='1. CADASTROS BASICOS'
         DFHMDF POS=(5,5),LENGTH=45,ATTRB=(PROT,NORM),                 X
               COLOR=GREEN,                                            X
               INITIAL='11 - EMPRESA E ESTABELECIMENTOS ...... SF05'
         DFHMDF POS=(6,5),LENGTH=45,ATTRB=(PROT,NORM),                 X
               COLOR=GREEN,                                            X
               INITIAL='12 - CARGOS E PISOS SALARIAIS ........ SF06'
         DFHMDF POS=(7,5),LENGTH=45,ATTRB=(PROT,NORM),                 X
               COLOR=GREEN,                                            X
               INITIAL='13 - DEPARTAMENTOS E CENTROS DE CUSTO  SF07'
         DFHMDF POS=(8,5),LENGTH=45,ATTRB=(PROT,NORM),                 X
               COLOR=GREEN,                                            X
               INITIAL='14 - TABELAS DE DOMINIO .............. SF08'
***********************************************************************
* BLOCO 2 - PESSOAL                                                   *
***********************************************************************
         DFHMDF POS=(4,44),LENGTH=28,ATTRB=(PROT,BRT),                 X
               COLOR=YELLOW,INITIAL='2. PESSOAL'
         DFHMDF POS=(5,46),LENGTH=33,ATTRB=(PROT,NORM),                X
               COLOR=GREEN,                                            X
               INITIAL='21 - ADMISSAO / CADASTRO .. SF01'
         DFHMDF POS=(6,46),LENGTH=33,ATTRB=(PROT,NORM),                X
               COLOR=GREEN,                                            X
               INITIAL='22 - DEPENDENTES .......... SF02'
         DFHMDF POS=(7,46),LENGTH=33,ATTRB=(PROT,NORM),                X
               COLOR=GREEN,                                            X
               INITIAL='23 - ALTERACAO DE CARGO ... SF09'
         DFHMDF POS=(8,46),LENGTH=33,ATTRB=(PROT,NORM),                X
               COLOR=GREEN,                                            X
               INITIAL='24 - DESLIGAMENTO ......... SF10'
***********************************************************************
* BLOCO 3 - FOLHA                                                     *
***********************************************************************
         DFHMDF POS=(10,3),LENGTH=28,ATTRB=(PROT,BRT),                 X
               COLOR=YELLOW,INITIAL='3. FOLHA DE PAGAMENTO'
         DFHMDF POS=(11,5),LENGTH=45,ATTRB=(PROT,NORM),                X
               COLOR=GREEN,                                            X
               INITIAL='31 - RUBRICAS E EVENTOS .............. SF04'
         DFHMDF POS=(12,5),LENGTH=45,ATTRB=(PROT,NORM),                X
               COLOR=GREEN,                                            X
               INITIAL='32 - LANCAMENTO DE MOVIMENTO ......... SF03'
         DFHMDF POS=(13,5),LENGTH=45,ATTRB=(PROT,NORM),                X
               COLOR=GREEN,                                            X
               INITIAL='33 - TABELAS LEGAIS (INSS/IRRF/SF) ... SF11'
         DFHMDF POS=(14,5),LENGTH=45,ATTRB=(PROT,NORM),                X
               COLOR=GREEN,                                            X
               INITIAL='34 - ABERTURA E FECHAMENTO DE COMPET.  SF12'
***********************************************************************
* BLOCO 4 - CONSULTAS                                                 *
***********************************************************************
         DFHMDF POS=(10,44),LENGTH=28,ATTRB=(PROT,BRT),                X
               COLOR=YELLOW,INITIAL='4. CONSULTAS'
         DFHMDF POS=(11,46),LENGTH=33,ATTRB=(PROT,NORM),               X
               COLOR=GREEN,                                            X
               INITIAL='41 - FICHA FINANCEIRA ..... SF13'
         DFHMDF POS=(12,46),LENGTH=33,ATTRB=(PROT,NORM),               X
               COLOR=GREEN,                                            X
               INITIAL='42 - ESPELHO DE PAGAMENTO . SF14'
         DFHMDF POS=(13,46),LENGTH=33,ATTRB=(PROT,NORM),               X
               COLOR=GREEN,                                            X
               INITIAL='43 - CRITICAS DA FOLHA .... SF15'
***********************************************************************
* AREA DE SELECAO                                                     *
***********************************************************************
         DFHMDF POS=(17,1),LENGTH=79,ATTRB=(PROT,NORM),                X
               COLOR=BLUE,                                             X
               INITIAL='---------------------------------------------- X
---------------------------------'
         DFHMDF POS=(18,5),LENGTH=18,ATTRB=(PROT,BRT),                 X
               COLOR=NEUTRAL,INITIAL='OPCAO DESEJADA ==>'
MOPCAO   DFHMDF POS=(18,24),LENGTH=2,ATTRB=(UNPROT,IC,NORM),           X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(18,27),LENGTH=1,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(18,32),LENGTH=22,ATTRB=(PROT,NORM),               X
               COLOR=BLUE,INITIAL='OU DIGITE A TRANSACAO:'
MTRANS   DFHMDF POS=(18,55),LENGTH=4,ATTRB=(UNPROT,NORM),              X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(18,60),LENGTH=1,ATTRB=(ASKIP,NORM)
***********************************************************************
* MENSAGEM E RODAPE                                                   *
***********************************************************************
MMENSAG  DFHMDF POS=(22,1),LENGTH=79,ATTRB=(PROT,BRT),                 X
               COLOR=RED
         DFHMDF POS=(24,1),LENGTH=79,ATTRB=(PROT,NORM),                X
               COLOR=BLUE,                                             X
               INITIAL='F3=SAIR  F1=AJUDA  ENTER=CONFIRMAR  LIMPAR=REINX
ICIAR                          '
***********************************************************************
         DFHMSD TYPE=FINAL
         END
